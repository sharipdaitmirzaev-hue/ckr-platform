# =============================================================================
# ЦКР 0.61.0-beta — PRODUCTION ENV TEMPLATE
# Скопируйте на сервер:
#   sudo mkdir -p /etc/ckr
#   sudo cp deploy/env/production.env.template /etc/ckr/ckr.env
#   sudo chmod 640 /etc/ckr/ckr.env
#   sudo chown root:ckr /etc/ckr/ckr.env
# Заполните РЕАЛЬНЫЕ значения. Файл НЕ коммитить. Значения ключей не логировать.
# =============================================================================

# Runtime: production. Deploy-скрипты ставят зависимости через
# `npm ci --include=dev`, иначе npm пропустит tailwindcss/postcss/typescript.
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# --- SITE (обязательно, HTTPS боевой домен без trailing slash) ---
NEXT_PUBLIC_SITE_URL=https://YOUR_DOMAIN

# --- SUPABASE (обязательно, production project) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Публичный ключ (один из вариантов):
# 1) Новый: Publishable key  → sb_publishable_...
# 2) Legacy: anon            → длинный JWT (Settings → API Keys → Legacy)
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_PUBLISHABLE_OR_LEGACY_ANON_KEY
# Альтернативное имя (опционально, если не задан ANON_KEY):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Серверный ключ (один из вариантов). НЕ публиковать в браузер.
# 1) Новый: Secret key       → sb_secret_...
# 2) Legacy: service_role    → длинный JWT (Settings → API Keys → Legacy)
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SECRET_OR_LEGACY_SERVICE_ROLE_KEY
# Альтернативное имя (опционально, если не задан SERVICE_ROLE_KEY):
# SUPABASE_SECRET_KEY=sb_secret_...

# --- STORAGE ---
# SUPABASE_DOCUMENTS_BUCKET=documents

# --- LIA ---
# В production для реального ИИ: openai + ключ. mock допустим только временно.
LIA_PROVIDER=openai
LIA_API_KEY=REPLACE_WITH_PROVIDER_KEY
LIA_API_BASE_URL=https://api.openai.com/v1
LIA_MODEL=gpt-4o-mini

# --- WEB SEARCH (server-side only) ---
LIA_WEB_SEARCH_PROVIDER=mock
LIA_WEB_SEARCH_ENGINE=serper
LIA_WEB_SEARCH_API_KEY=
LIA_WEB_SEARCH_BASE_URL=
LIA_WEB_SEARCH_METHOD=POST

# --- PAYMENTS ---
PAYMENT_PROVIDER=mock

# --- DEMO / SEED — В PRODUCTION ВСЕГДА ВЫКЛЮЧЕНО ---
NEXT_PUBLIC_DEMO_MODE=false
DEMO_CATALOG_FALLBACK=false
DEMO_SEED_SECRET=
ALLOW_DEMO_SEED_IN_PRODUCTION=false
PILOT_SEED_SECRET=
ALLOW_PILOT_SEED_IN_PRODUCTION=false

# --- BETA ---
NEXT_PUBLIC_BETA_REQUIRE_INVITE=false
