# =============================================================================
# ЦКР — переменные окружения
# Скопируйте в .env.local для разработки.
# В production задайте через секреты hosting / CI. НЕ коммитьте реальные ключи.
# =============================================================================

# --- SITE ---
# Production: https://<REAL_DOMAIN>  (без trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Опционально: путь к загруженному логотипу в /public (см. public/brand/README.md)
# NEXT_PUBLIC_BRAND_LOGO_PATH=/brand/logo.svg

# --- COMPANY / CONTACTS (не заполнять фиктивными данными) ---
# NEXT_PUBLIC_COMPANY_LEGAL_NAME=
# NEXT_PUBLIC_COMPANY_DISPLAY_NAME=ЦКР
# NEXT_PUBLIC_COMPANY_INN=
# NEXT_PUBLIC_COMPANY_OGRN=
# NEXT_PUBLIC_COMPANY_OGRNIP=
# NEXT_PUBLIC_COMPANY_ADDRESS=
# NEXT_PUBLIC_COMPANY_EMAIL=
# NEXT_PUBLIC_COMPANY_PHONE=
# NEXT_PUBLIC_COMPANY_TELEGRAM=
# NEXT_PUBLIC_COMPANY_WORKING_HOURS=

# --- SUPABASE (обязательно) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Только сервер. НЕ публиковать в браузер.
SUPABASE_SERVICE_ROLE_KEY=

# --- STORAGE ---
# Бакет документов создаётся миграцией verification (по умолчанию: documents)
# SUPABASE_DOCUMENTS_BUCKET=documents

# --- LIA ---
# mock | openai
# В production не оставляйте mock, если нужен реальный ИИ.
LIA_PROVIDER=mock
LIA_API_KEY=
LIA_API_BASE_URL=
LIA_MODEL=gpt-4o-mini

# --- WEB SEARCH (Лия, только server-side) ---
# mock | web_api | custom
LIA_WEB_SEARCH_PROVIDER=mock
# serper | brave | tavily | generic
LIA_WEB_SEARCH_ENGINE=serper
LIA_WEB_SEARCH_API_KEY=
LIA_WEB_SEARCH_BASE_URL=
LIA_WEB_SEARCH_METHOD=POST

# --- EMAIL ---
# Письма Auth идут через Supabase Auth (встроенный или внешний SMTP в dashboard).
# Credentials SMTP НЕ хранить в этом репозитории — только в Supabase project settings.
# См. docs/email-setup.md

# --- ANALYTICS ---
# First-party events в analytics_events. Отдельный сторонний продукт не требуется.
# NEXT_PUBLIC_DEMO_MODE влияет на демо-бейджи, не на аналитику.

# --- PAYMENTS ---
# mock | yookassa | cloudpayments | custom  (пока реализован mock)
PAYMENT_PROVIDER=mock
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# CLOUDPAYMENTS_PUBLIC_ID=
# CLOUDPAYMENTS_API_SECRET=

# --- DEMO / SEED (не нужны для обычной работы пользователя) ---
NEXT_PUBLIC_DEMO_MODE=true
DEMO_CATALOG_FALLBACK=true
DEMO_SEED_SECRET=
ALLOW_DEMO_SEED_IN_PRODUCTION=false

# --- Pilot TINDA seed (не использовать для обычного go-live) ---
PILOT_SEED_SECRET=
ALLOW_PILOT_SEED_IN_PRODUCTION=false

# --- Closed beta ---
NEXT_PUBLIC_BETA_REQUIRE_INVITE=false
