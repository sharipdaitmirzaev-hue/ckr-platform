# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Этап 1 — обязательно для Auth)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Только для сервисных/admin задач (не использовать в браузере)
SUPABASE_SERVICE_ROLE_KEY=

# Лия / LLM (Этап 9)
# mock — локальные сценарии и поиск по ЦКР без внешнего API
# openai — OpenAI-compatible через LIA_API_BASE_URL
LIA_PROVIDER=mock
LIA_API_KEY=
LIA_API_BASE_URL=
LIA_MODEL=gpt-4o-mini

# Лия / внешний поиск (Этап 12)
# Провайдер: mock | web_api | custom
LIA_WEB_SEARCH_PROVIDER=mock
# Для web_api: serper | brave | tavily | generic
LIA_WEB_SEARCH_ENGINE=serper
LIA_WEB_SEARCH_API_KEY=
# Обязателен для custom и engine=generic
LIA_WEB_SEARCH_BASE_URL=
# Для custom: POST | GET
LIA_WEB_SEARCH_METHOD=POST

# Платежи (Этап 16) — пока только mock, без реальных списаний
# Позже: yookassa | cloudpayments | custom
PAYMENT_PROVIDER=mock
