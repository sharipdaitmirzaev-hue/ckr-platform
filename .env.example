# =============================================================================
# ЦКР — переменные окружения
# Скопируйте в .env.local для разработки. В production задайте через секреты CI/host.
# =============================================================================

# --- Public site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NODE_ENV задаётся платформой (development | production)

# --- Supabase (обязательно) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Публичный ключ: sb_publishable_... (новый) ИЛИ legacy anon JWT
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Только сервер: sb_secret_... (новый) ИЛИ legacy service_role JWT. НЕ в браузер.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# --- Storage ---
# Бакет документов создаётся миграцией verification (имя по умолчанию: documents)
# SUPABASE_DOCUMENTS_BUCKET=documents

# --- Лия / LLM ---
# mock | openai
LIA_PROVIDER=mock
LIA_API_KEY=
LIA_API_BASE_URL=
LIA_MODEL=gpt-4o-mini

# --- Лия / внешний поиск (Search provider) ---
# mock | web_api | custom
LIA_WEB_SEARCH_PROVIDER=mock
# serper | brave | tavily | generic
LIA_WEB_SEARCH_ENGINE=serper
LIA_WEB_SEARCH_API_KEY=
LIA_WEB_SEARCH_BASE_URL=
LIA_WEB_SEARCH_METHOD=POST
# Owner OI: auto | stub | live (см. docs/lia-oi.md). LIVE только при web_api + API key.
LIA_OI_SEARCH_MODE=auto
# Persistence OI: memory (default) | supabase.
# supabase требует применённых migrations Stage 1+2B и SUPABASE_SERVICE_ROLE_KEY.
# НЕ включать supabase на production до явного apply SQL.
LIA_OI_STORE=memory

# --- Лия / официальные API (Stage 2C.3 readiness) ---
# Только server-side. Без значений код использует fixtures; live-запросов нет.
# См. docs/lia-official-data-access.md
# ЕИС (SOAP/XML):
# LIA_EIS_ENABLED=false
# LIA_EIS_TOKEN=
# LIA_EIS_ENDPOINT=
# ЕФРСБ (REST JWT):
# LIA_FEDRESURS_ENABLED=false
# LIA_FEDRESURS_LOGIN=
# LIA_FEDRESURS_PASSWORD=
# LIA_FEDRESURS_BASE_URL=

# --- Payment provider ---
# mock | yookassa | cloudpayments | custom  (пока реализован mock)
PAYMENT_PROVIDER=mock
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# CLOUDPAYMENTS_PUBLIC_ID=
# CLOUDPAYMENTS_API_SECRET=

# --- Demo / seed ---
NEXT_PUBLIC_DEMO_MODE=true
DEMO_CATALOG_FALLBACK=true
DEMO_SEED_SECRET=
# В production seed отключён, пока не true явно:
ALLOW_DEMO_SEED_IN_PRODUCTION=false

# --- Pilot TINDA seed ---
# Секрет для POST /api/pilot/tinda-seed (можно совпадать с DEMO_SEED_SECRET)
PILOT_SEED_SECRET=
# В production seed пилота отключён, пока не true явно:
ALLOW_PILOT_SEED_IN_PRODUCTION=false

# --- Closed beta ---
NEXT_PUBLIC_BETA_REQUIRE_INVITE=false
